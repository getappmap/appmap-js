#!/usr/bin/env node

// Builds a native binary of the package in the current directory for the
// current platform, with pkg. Shared by packages/cli and packages/scanner
// (whose bin/build-native is a symlink to this file).
//
//   build-native [OS [ARCH]]
//
// OS and ARCH are pkg's names (linux, macos, win; x64, arm64). They are
// optional and only asserted against the current platform: cross-platform
// builds are not supported. Two things break them. pkg compiles bytecode on
// the host, and V8 on the target rejects it. And native addons
// (better-sqlite3) are packaged as yarn install compiled them, because pkg's
// own prebuild-install step cannot find prebuild-install in this workspace and
// would request the wrong ABI anyway (its node-abi maps Node 22 to 124). Both
// failures are silent at build time and only show when the binary runs.
//
// The pkg target comes from the package's pkg.targets, which is therefore the
// single place the supported platforms and the Node version are declared.

const { spawnSync } = require('child_process');
const { resolve } = require('path');

const hostOs = { linux: 'linux', darwin: 'macos', win32: 'win' }[process.platform];
const hostArch = process.arch;

const [os = hostOs, arch = hostArch] = process.argv.slice(2);
if (os !== hostOs || arch !== hostArch) {
  console.error(
    `build-native: cannot build for ${os}-${arch} on ${hostOs}-${hostArch}; ` +
      'only builds for the current platform are supported.'
  );
  process.exit(1);
}

const packageJson = require(resolve('package.json'));
const pkgName = packageJson.name.split('/').pop();
const target = packageJson.pkg.targets.find((t) => t.endsWith(`-${os}-${arch}`));
if (!target) {
  console.error(`build-native: no pkg target for ${os}-${arch} in package.json`);
  process.exit(1);
}

// NOTE: The Node version of the targets (e.g. node22) MUST match the Node
// version configured in GHA workflows and actions (e.g. setup-node/action.yml),
// because native addons compiled by yarn install on the runner are packaged
// as-is (see --no-native-build below).
//
// Note that Node 24+ officially dropped support for macOS < 13.5 due to newer
// libc++ requirements. Keeping the target at Node 22 ensures backward
// compatibility with older macOS versions.

console.log(`Building native binary for ${target}...`);

// --no-native-build: package the addons yarn install built rather than let pkg
// try to fetch prebuilt ones. CI deliberately compiles them against old glibc
// (in the RHEL 8 container) and with MACOSX_DEPLOYMENT_TARGET.
const args = [
  'pkg',
  '--config',
  'package.json',
  '--compress',
  'Brotli',
  '--no-native-build',
  '-t',
  target,
  '-o',
  `release/${pkgName}-${os}-${arch}`,
  'built/cli.js',
];
const { status, error } = spawnSync('yarn', args, {
  stdio: 'inherit',
  shell: process.platform === 'win32',
});
if (error) throw error;
process.exit(status ?? 1);
